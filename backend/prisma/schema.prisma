
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model User {
  id       String @id @default(uuid())
  email    String @unique
  password String
  createdAt DateTime @default(now())
  
  files File[]
}

model File {
  id String @id @default(uuid())
  name String
  path String
  userId String
  user User @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}